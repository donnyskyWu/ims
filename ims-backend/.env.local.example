# IMS_MYSQL_HOST=47.110.62.216
# IMS_MYSQL_USER=shenyu
# IMS_MYSQL_PASSWORD=
# IMS_CLOUD_MYSQL_PASSWORD=

IMS_DINGTALK_CORP_ID=
IMS_DINGTALK_CLIENT_ID=
IMS_DINGTALK_CLIENT_SECRET=
IMS_DINGTALK_AGENT_ID=
IMS_DINGTALK_APP_ID=
IMS_DINGTALK_TOKEN=
IMS_DINGTALK_AES_KEY=

IMS_DINGTALK_L3=1

IMS_FOOTBALL_WEBAPI_BASE_URL=https://saas.shenyu.com/

