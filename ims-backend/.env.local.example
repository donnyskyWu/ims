# PO：复制本文件为 ims-backend/.env（已在 .gitignore，勿提交）
# cp .env.local.example .env   # macOS/Linux
# Copy-Item .env.local.example .env   # Windows PowerShell
#
# 若 Client Secret 曾在聊天/邮件中暴露，请在钉钉开放平台轮换后再写入 .env。

# --- 本地 MySQL（默认）---
IMS_MYSQL_USER=root
IMS_MYSQL_PASSWORD=root
IMS_MYSQL_HOST=127.0.0.1
IMS_MYSQL_PORT=3306
IMS_DB=ims
IMS_OPS_DB=opsbiz
IMS_PORT=18080

# --- 云 MySQL（联调时取消注释并填密码，勿提交 .env）---
