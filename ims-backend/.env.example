# IMS backend — 变量名清单（勿在此填真实密钥；复制见 .env.local.example → .env）
# MySQL（本地默认）
IMS_MYSQL_USER=root
IMS_MYSQL_PASSWORD=
IMS_MYSQL_HOST=127.0.0.1
IMS_MYSQL_PORT=3306
IMS_DB=ims
IMS_OPS_DB=opsbiz

# 云 MySQL（仅 PO 本机 .env；见 doc/运维/云MySQL联调.md）
# IMS_USE_CLOUD_DB=1
# IMS_MYSQL_HOST=47.110.62.216
# IMS_MYSQL_USER=shenyu
# IMS_MYSQL_PASSWORD=
# 或整串（密码须 URL 编码）：IMS_DATABASE_URL=mysql+pymysql://user:pass@host:3306/ims?charset=utf8mb4
# 同步脚本用：IMS_CLOUD_MYSQL_HOST / IMS_CLOUD_MYSQL_USER / IMS_CLOUD_MYSQL_PASSWORD

# API
IMS_PORT=18080
IMS_JWT_SECRET=

# 钉钉 / Football：生产推荐在 UI「系统管理 → 系统参数」维护；以下为首次 bootstrap / CI 回退
# 钉钉组织 · 回调验签（未配 DB 时 dev 默认见 settings_runtime）
IMS_DINGTALK_TOKEN=
IMS_DINGTALK_AES_KEY=
IMS_DINGTALK_CORP_ID=
IMS_DINGTALK_CLIENT_ID=
IMS_DINGTALK_CLIENT_SECRET=
IMS_DINGTALK_AGENT_ID=
IMS_DINGTALK_APP_ID=
# 1 或系统参数 dingtalk.l3Enabled=true → 运行 test_org_dingtalk_l3.py 真实 API
IMS_DINGTALK_L3=

# Football WebAPI 根地址（示例 https://saas.shenyu.com/；空 → 桩）
IMS_FOOTBALL_WEBAPI_BASE_URL=
IMS_FOOTBALL_TIMEOUT_SEC=3
IMS_FOOTBALL_ARTICLE_STUB=

# BI 钉钉群机器人（可选）
IMS_BI_DINGTALK_WEBHOOK_URL=

# unify-collector（只放占位，勿提交真实 token / cookie）
IMS_COLLECTOR_BASE_URL=
IMS_COLLECTOR_TOKEN=
# 真实冒烟 scripts/collector_smoke_kuaishou.py 另需（只放占位，脚本不打印 token）：
# IMS_COLLECTOR_KUAISHOU_ACCOUNT_ID=
# 真实冒烟 scripts/collector_smoke_douyin.py 另需：
# IMS_COLLECTOR_DOUYIN_ACCOUNT_ID=
