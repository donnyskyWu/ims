{
  "name": "ims-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run_e2e.ps1",
    "test:e2e:dingtalk": "powershell -NoProfile -ExecutionPolicy Bypass -File ../ims-backend/scripts/run_dingtalk_l3.ps1",
    "test:e2e:ci:playwright-only": "playwright test --reporter=list,html",
    "test:e2e:skip": "cross-env SKIP_E2E=1 playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
